{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/session_start.py\"",
            "statusMessage": "Loading compact DocOps context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|pwsh|Shell|cmd|exec_command|write_stdin|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/post_tool_use.py\"",
            "statusMessage": "Recording DocOps event"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/stop.py\"",
            "statusMessage": "Checking DocOps consistency"
          }
        ]
      }
    ]
  }
}
