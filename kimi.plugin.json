{
  "name": "docops-logic",
  "version": "0.3.0",
  "description": "Low-token DocOps workflow with budgeted current projections and exact archived history.",
  "author": {
    "name": "DocOps Logic"
  },
  "homepage": "https://github.com/leezear2022/codex-docops-logic",
  "license": "MIT",
  "keywords": [
    "docops",
    "workflow",
    "constraints",
    "exchange"
  ],
  "skills": "./skills/",
  "interface": {
    "displayName": "DocOps Logic",
    "shortDescription": "Compact workflow state, evidence, and handoffs",
    "longDescription": "Track compact state, enforce current-document token budgets, preserve exact indexed history, and manage deterministic evidence and handoffs.",
    "developerName": "DocOps Logic",
    "websiteURL": "https://github.com/leezear2022/codex-docops-logic"
  },
  "hooks": [
    {
      "event": "SessionStart",
      "command": "python \"./hooks/session_start.py\"",
      "timeout": 10
    },
    {
      "event": "PostToolUse",
      "matcher": "Bash|PowerShell|pwsh|Shell|cmd|exec_command|write_stdin|apply_patch|Edit|Write",
      "command": "python \"./hooks/post_tool_use.py\"",
      "timeout": 10
    },
    {
      "event": "Stop",
      "command": "python \"./hooks/stop.py\"",
      "timeout": 10
    }
  ]
}
